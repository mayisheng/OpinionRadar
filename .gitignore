# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# 工具缓存
.pytest_cache/
.mypy_cache/
.ruff_cache/

# 本地配置与密钥（只提交 *.example）
.env
config/config.yaml

# 运行数据（数据库、原始内容、日志）
data/
*.db
*.sqlite3

# 系统
.DS_Store

# TRAE 本地工作目录（规划文档、技能本地软链等），仅存本机，不入库
.trae/

# Agent 协作资产（需随仓库共享，勿忽略）：
# - AGENTS.md：项目规则
# - .agents/skills/：项目自建技能的权威副本（Agent Skills 规范目录）
#   本地使用时在 .trae/skills/<name> 建指向 ../../.agents/skills/<name> 的软链接，
#   或在 TRAE 设置中启用 .agents 技能目录；该软链不入库
