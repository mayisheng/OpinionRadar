# 复制为 .env 并填入真实值；.env 已在 .gitignore 中，切勿提交
# 所有变量统一使用 OPINION_RADAR_ 前缀

# B站登录 Cookie（迭代 002 付费/充电内容需要；迭代 001 公开内容可留空）
# 获取方式见 docs/runbook/operations.md
OPINION_RADAR_BILIBILI_SESSDATA=

# Server酱 SendKey（https://sct.ftqq.com/ 微信扫码登录后获取）
OPINION_RADAR_SERVERCHAN_SENDKEY=

# PushPlus Token（备选推送渠道，https://www.pushplus.plus/）
OPINION_RADAR_PUSHPLUS_TOKEN=

# 云端兜底模型 API Key（可选，迭代 005）
OPINION_RADAR_LLM_API_KEY=

# 配置文件路径（可选，默认 config/config.yaml）
# OPINION_RADAR_CONFIG=config/config.yaml
